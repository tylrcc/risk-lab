  "good": "#059669",
  "neutral": "#d97706",
  "bad": "#dc2626",
  "textClasses": {
    "title": { "fontSize": 12, "fontFace": "Segoe UI", "color": "#111827" },
    "label": { "fontSize": 9, "fontFace": "Segoe UI", "color": "#374151" },
    "callout": { "fontSize": 22, "fontFace": "Segoe UI Semibold", "color": "#111827" }
